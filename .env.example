# Copy to .env.local and fill in. Everything is optional:
# without these keys the comparison engine, flags and scoring still work fully.

# --- Groq (AI paste-to-fill, insights, chat) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_EXTRACTION_MODEL=openai/gpt-oss-20b
GROQ_EXTRACTION_FALLBACK_MODEL=llama-3.1-8b-instant
GROQ_INSIGHT_MODEL=openai/gpt-oss-120b
GROQ_INSIGHT_FALLBACK_MODEL=llama-3.3-70b-versatile
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_CHAT_FALLBACK_MODEL=openai/gpt-oss-20b

# --- Supabase (persistence). Server-side only — never expose the service role key to the browser.
# Without these, data is stored in .data/local_db.json (or /tmp on Vercel, ephemeral).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Date treated as "today" for validity and delivery checks
REFERENCE_DATE=2026-11-24
